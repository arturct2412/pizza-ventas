rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /productos/{idProducto} {
      // Permite leer y modificar productos solo a usuarios autenticados.
      allow read, write: if request.auth != null;
    }
    match /ventas/{idVenta} {
      // Permite registrar y consultar ventas solo a usuarios autenticados.
      allow read, write: if request.auth != null;
    }
  }
}
